# Google Maps browser key: restrict by HTTP referrer and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=replace_with_a_browser_restricted_key

# Open-Meteo needs no API key. The preview endpoint uses it when enabled.
OPEN_METEO_ENABLED=true
OPEN_METEO_ROUTING_ENABLED=false
OPEN_METEO_TIMEOUT_SECONDS=4
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# To add a commercial provider later, implement the same conditions() interface.
WEATHER_PROVIDER=open-meteo
