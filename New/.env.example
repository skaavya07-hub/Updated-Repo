# Google Maps browser key: restrict by HTTP referrer and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=replace_with_a_browser_restricted_key

# OpenWeather server-side key. Never expose it in React or commit a real key.
OPENWEATHER_API_KEY=replace_with_your_openweather_key
OPENWEATHER_ENABLED=true
OPENWEATHER_ROUTING_ENABLED=true
OPENWEATHER_TIMEOUT_SECONDS=4
OPENWEATHER_FORECAST_URL=https://api.openweathermap.org/data/2.5/forecast
